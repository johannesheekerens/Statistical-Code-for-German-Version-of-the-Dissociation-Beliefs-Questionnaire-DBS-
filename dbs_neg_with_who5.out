INPUT INSTRUCTIONS

  TITLE:  Correlation - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:   FILE = data.txt;

  VARIABLE:
          NAMES = id who1-who5 bfi1-bfi15 erq1-erq30 ibes1-ibes4
          perci1-perci32 paq1-paq24 dass1-dass21 brid1-brid6
          ctq1-ctq28 smdq1-smdq9 dbs1-dbs16;
          USEVARIABLES = who1-who5 dbs4 dbs6 dbs8 dbs9 dbs10 dbs11 dbs12 dbs14;
          MISSING = *;

  ANALYSIS:
          ESTIMATOR = MLR;

  MODEL:
          ! measurement model
          dbs_neg BY dbs4*
                     dbs6
                     dbs8
                     dbs9
                     dbs10
                     dbs11
                     dbs12
                     dbs14 ;
          dbs_neg@1;

          who BY who1*
                 who2-who5;
          who@1;

          dbs_neg WITH who;

  OUTPUT: STANDARDIZED CINTERVAL;



