INPUT INSTRUCTIONS

  TITLE:  Reliability - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:   FILE = cfa.txt;

  VARIABLE:
          NAMES = id dbs1-dbs16;
          USEVARIABLES = dbs4 dbs6 dbs8 dbs9 dbs10 dbs11 dbs12 dbs14;
          MISSING = *;

  ANALYSIS:
          ESTIMATOR = MLR;

  MODEL:
          ! measurement model
          dbs_neg BY dbs4*  (load1)
                     dbs6   (load2)
                     dbs8   (load3)
                     dbs9   (load4)
                     dbs10  (load5)
                     dbs11  (load6)
                     dbs12  (load7)
                     dbs14  (load8);
          dbs_neg@1;

          ! residual variances
          dbs4   (resv1);
          dbs6   (resv2);
          dbs8   (resv3);
          dbs9   (resv4);
          dbs10  (resv5);
          dbs11  (resv6);
          dbs12  (resv7);
          dbs14  (resv8);

  MODEL CONSTRAINT:
          NEW(omega);
          omega = (load1+load2+load3+load4+load5+load6+load7+load8)^2 /
                  ((load1+load2+load3+load4+load5+load6+load7+load8)^2 +
                   resv1+resv2+resv3+resv4+resv5+resv6+resv7+resv8);

  OUTPUT: STANDARDIZED CINTERVAL;



