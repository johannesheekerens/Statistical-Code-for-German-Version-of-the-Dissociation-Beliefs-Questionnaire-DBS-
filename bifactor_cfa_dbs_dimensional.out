Mplus VERSION 9
MUTHEN & MUTHEN
11/02/2026   1:55 PM

INPUT INSTRUCTIONS

  TITLE:    Bifactor CFA - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:     FILE = cfa.txt;

  VARIABLE:
            NAMES = id dbs1-dbs16;
            USEVARIABLES = dbs1-dbs16;
            MISSING = *;

  ANALYSIS: ESTIMATOR = MLR;

  MODEL:

    ! bifactor measurement model (orthogonal)
    ! based on:
    ! https://doi.org/10.1017/S1352465823000097

    ! general factor: all 16 items
    dbs_g BY  dbs1*  (g1)
              dbs2   (g2)
              dbs3   (g3)
              dbs4   (g4)
              dbs5   (g5)
              dbs6   (g6)
              dbs7   (g7)
              dbs8   (g8)
              dbs9   (g9)
              dbs10  (g10)
              dbs11  (g11)
              dbs12  (g12)
              dbs13  (g13)
              dbs14  (g14)
              dbs15  (g15)
              dbs16  (g16);
    dbs_g@1;

    ! specific factor: positive beliefs
    dbs_pos BY dbs1*  (p1)
               dbs2   (p2)
               dbs3   (p3)
               dbs5   (p5)
               dbs7   (p7)
               dbs13  (p13)
               dbs15  (p15)
               dbs16  (p16);
    dbs_pos@1;

    ! specific factor: negative beliefs
    dbs_neg BY dbs4*  (n4)
               dbs6   (n6)
               dbs8   (n8)
               dbs9   (n9)
               dbs10  (n10)
               dbs11  (n11)
               dbs12  (n12)
               dbs14  (n14);
    dbs_neg@1;

    ! orthogonality constraints
    dbs_g   WITH dbs_pos@0;
    dbs_g   WITH dbs_neg@0;
    dbs_pos WITH dbs_neg@0;

    ! residual variances
    dbs1  (e1);   dbs2  (e2);   dbs3  (e3);   dbs4  (e4);
    dbs5  (e5);   dbs6  (e6);   dbs7  (e7);   dbs8  (e8);
    dbs9  (e9);   dbs10 (e10);  dbs11 (e11);  dbs12 (e12);
    dbs13 (e13);  dbs14 (e14);  dbs15 (e15);  dbs16 (e16);

  MODEL CONSTRAINT:
    NEW(sg sp sn se sep sen
        sg2 sp2 sn2
        omegaT omegaH omegaHSp omegaHSn ecv);

    ! sums of loadings
    sg = g1+g2+g3+g4+g5+g6+g7+g8+g9+g10+g11+g12+g13+g14+g15+g16;
    sp = p1+p2+p3+p5+p7+p13+p15+p16;
    sn = n4+n6+n8+n9+n10+n11+n12+n14;

    ! sums of residual variances
    se  = e1+e2+e3+e4+e5+e6+e7+e8+e9+e10+e11+e12+e13+e14+e15+e16;
    sep = e1+e2+e3+e5+e7+e13+e15+e16;
    sen = e4+e6+e8+e9+e10+e11+e12+e14;

    ! sums of squared loadings
    sg2 = g1**2+g2**2+g3**2+g4**2+g5**2+g6**2+g7**2+g8**2+
          g9**2+g10**2+g11**2+g12**2+g13**2+g14**2+g15**2+g16**2;
    sp2 = p1**2+p2**2+p3**2+p5**2+p7**2+p13**2+p15**2+p16**2;
    sn2 = n4**2+n6**2+n8**2+n9**2+n10**2+n11**2+n12**2+n14**2;

    ! omega total and omega hierarchical (total score)
    omegaT = (sg**2 + sp**2 + sn**2) / (sg**2 + sp**2 + sn**2 + se);
    omegaH = sg**2 / (sg**2 + sp**2 + sn**2 + se);

    ! omega hierarchical subscale (specific factor, general partialled out)
    omegaHSp = sp**2 /
      ((g1+g2+g3+g5+g7+g13+g15+g16)**2 + sp**2 + sep);
    omegaHSn = sn**2 /
      ((g4+g6+g8+g9+g10+g11+g12+g14)**2 + sn**2 + sen);

    ! explained common variance of the general factor
    ecv = sg2 / (sg2 + sp2 + sn2);

  OUTPUT:   STANDARDIZED CINTERVAL SVALUES;



