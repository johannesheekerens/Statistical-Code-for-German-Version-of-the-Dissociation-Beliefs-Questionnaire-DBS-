INPUT INSTRUCTIONS

  TITLE:  Correlation - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:   FILE = data.txt;

  VARIABLE:
          NAMES = id who1-who5 bfi1-bfi15 erq1-erq30 ibes1-ibes4
          perci1-perci32 paq1-paq24 dass1-dass21 brid1-brid6
          ctq1-ctq28 smdq1-smdq9 dbs1-dbs16;
          USEVARIABLES = smdq1 smdq4 smdq7
          dbs1 dbs2 dbs3 dbs5 dbs7 dbs13 dbs15 dbs16;
          MISSING = *;

  ANALYSIS:
          ESTIMATOR = MLR;

  MODEL:
          ! measurement model
          dbs_pos BY dbs1*
                     dbs2
                     dbs3
                     dbs5
                     dbs7
                     dbs13
                     dbs15
                     dbs16;
          dbs_pos@1;

          world BY smdq1*
                   smdq4
                   smdq7;
          world@1;

          dbs_pos WITH world;

  OUTPUT: STANDARDIZED CINTERVAL;



