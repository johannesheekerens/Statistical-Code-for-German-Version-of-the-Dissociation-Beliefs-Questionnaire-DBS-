Mplus VERSION 9
MUTHEN & MUTHEN
11/02/2026   2:09 PM

INPUT INSTRUCTIONS

  TITLE: Multi-group bifactor CFA for configural invariance
         across the German and French versions;

  DATA:
      FILE = mg_cfa.txt;

  VARIABLE:
      NAMES = id dbs1-dbs16 group;
      USEVARIABLES = dbs1-dbs16;
      GROUPING = group (1 = German 2 = French);

  ANALYSIS:
      ESTIMATOR = MLR;
      STARTS = 20;

  MODEL:
      dbs_g BY dbs1*
               dbs2-dbs16;

      dbs_pos BY dbs1*
                 dbs2
                 dbs3
                 dbs5
                 dbs7
                 dbs13
                 dbs15
                 dbs16;

      dbs_neg BY dbs4*
                 dbs6
                 dbs8
                 dbs9
                 dbs10
                 dbs11
                 dbs12
                 dbs14;

      [dbs_g@0 dbs_pos@0 dbs_neg@0];

      dbs_g@1;
      dbs_pos@1;
      dbs_neg@1;

      dbs_g WITH dbs_pos@0;
      dbs_g WITH dbs_neg@0;
      dbs_pos WITH dbs_neg@0;

      [dbs1-dbs16*];
      dbs1-dbs16*;

  MODEL French:
      dbs_g BY dbs1*
               dbs2-dbs16;

      dbs_pos BY dbs1*
                 dbs2
                 dbs3
                 dbs5
                 dbs7
                 dbs13
                 dbs15
                 dbs16;

      dbs_neg BY dbs4*
                 dbs6
                 dbs8
                 dbs9
                 dbs10
                 dbs11
                 dbs12
                 dbs14;

      [dbs_g@0 dbs_pos@0 dbs_neg@0];

      dbs_g@1;
      dbs_pos@1;
      dbs_neg@1;

      dbs_g WITH dbs_pos@0;
      dbs_g WITH dbs_neg@0;
      dbs_pos WITH dbs_neg@0;

      [dbs1-dbs16*];
      dbs1-dbs16*;

  OUTPUT: STANDARDIZED SVALUES MODINDICES(5);



INPUT READING TERMINATED NORMALLY



