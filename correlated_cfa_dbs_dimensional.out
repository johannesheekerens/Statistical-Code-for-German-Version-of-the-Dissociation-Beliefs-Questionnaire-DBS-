INPUT INSTRUCTIONS

      TITLE:  CFA - German Version of the Dissociation Beliefs Scale (DBS)

        DATA:  file = cfa.txt;

            VARIABLE:
             NAMES = id dbs1-dbs16;

           USEVARIABLES = dbs1-dbs16;

               MISSING = *;

         ANALYSIS: ESTIMATOR = MLR;

         MODEL:
         ! measurement model
         ! correlated factors
         dbs_pos BY    dbs1*
                       dbs2
                       dbs3
                       dbs5
                       dbs7
                       dbs13
                       dbs15
                       dbs16;
         dbs_pos@1;

         dbs_neg BY    dbs4*
                       dbs6
                       dbs8
                       dbs9
                       dbs10
                       dbs11
                       dbs12
                       dbs14;
         dbs_neg@1;

         dbs_pos WITH dbs_neg;

         ! original hierarchical structure is not identified
         ! on the level of the higher-order factor
         ! https://doi.org/10.1017/S1352465823000097

         OUTPUT: standardized CINTERVAL SVALUES;



