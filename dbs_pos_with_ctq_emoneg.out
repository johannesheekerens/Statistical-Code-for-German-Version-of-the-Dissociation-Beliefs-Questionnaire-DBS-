INPUT INSTRUCTIONS

  TITLE:  Correlation - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:   FILE = data.txt;

  VARIABLE:
          NAMES = id who1-who5 bfi1-bfi15 erq1-erq30 ibes1-ibes4
          perci1-perci32 paq1-paq24 dass1-dass21 brid1-brid6
          ctq1-ctq28 smdq1-smdq9 dbs1-dbs16;
          USEVARIABLES = ctq5 ctq7 ctq13 ctq19 ctq28
          dbs1 dbs2 dbs3 dbs5 dbs7 dbs13 dbs15 dbs16;
          MISSING = *;

  ANALYSIS:
          ESTIMATOR = MLR;

  DEFINE:
  ctq5 = 6-ctq5;
  ctq7 = 6-ctq7;
  ctq13 = 6-ctq13;
  ctq19 = 6-ctq19;
  ctq28 = 6-ctq28;

  MODEL:
          ! measurement model
          dbs_pos BY dbs1*
                     dbs2
                     dbs3
                     dbs5
                     dbs7
                     dbs13
                     dbs15
                     dbs16;
          dbs_pos@1;

          ctq BY ctq5* ctq7 ctq13 ctq19 ctq28;
          ctq@1;

          dbs_pos WITH ctq;

  OUTPUT: STANDARDIZED CINTERVAL;



