Mplus VERSION 9
MUTHEN & MUTHEN
11/02/2026   3:05 PM

INPUT INSTRUCTIONS

  TITLE:  Correlation - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:   FILE = data.txt;

  VARIABLE:
          NAMES = id who1-who5 bfi1-bfi15 erq1-erq30 ibes1-ibes4
          perci1-perci32 paq1-paq24 dass1-dass21 brid1-brid6
          ctq1-ctq28 smdq1-smdq9 dbs1-dbs16;
          USEVARIABLES = ibes1-ibes4 dbs4 dbs6 dbs8 dbs9 dbs10 dbs11 dbs12 dbs14;
          MISSING = *;

  ANALYSIS:
          ESTIMATOR = MLR;

  DEFINE:
  ibes3 = 5-ibes3;
  ibes4 = 5-ibes4;

  ! implicit beliefs about emotion scale
  ! controllability of emotional states

  MODEL:
          ! measurement model
          dbs_neg BY dbs4*
                     dbs6
                     dbs8
                     dbs9
                     dbs10
                     dbs11
                     dbs12
                     dbs14 ;
          dbs_neg@1;

          ibes BY ibes1*
                 ibes2-ibes4;
          ibes@1;

          dbs_neg WITH ibes;

  OUTPUT: STANDARDIZED CINTERVAL;



