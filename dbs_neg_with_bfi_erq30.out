Mplus VERSION 9
MUTHEN & MUTHEN
11/02/2026   3:05 PM

INPUT INSTRUCTIONS

  TITLE: Correlations - German DBS Negative Beliefs and ERQ-30;

  DATA:
    FILE = data.txt;

  VARIABLE:
    NAMES = id who1-who5 bfi1-bfi15 erq1-erq30 ibes1-ibes4
            perci1-perci32 paq1-paq24 dass1-dass21 brid1-brid6
            ctq1-ctq28 smdq1-smdq9 dbs1-dbs16;

    USEVARIABLES = erq1-erq30
                   dbs4 dbs6 dbs8 dbs9 dbs10 dbs11 dbs12 dbs14;

    MISSING = *;

  ANALYSIS:
    ESTIMATOR = MLR;

  MODEL:
    ! Negative beliefs about dissociation
    ! Retain the German DBS item assignments from your code
    dbs_neg BY dbs4* dbs6 dbs8 dbs9
               dbs10 dbs11 dbs12 dbs14;
    dbs_neg@1;

    ! ERQ-30: Behavioral activation
    beh_act BY erq4* erq14 erq23;
    beh_act@1;

    ! Problem solving
    prob_sol BY erq6* erq16 erq25;
    prob_sol@1;

    ! Situational avoidance
    sit_avo BY erq5* erq15 erq24;
    sit_avo@1;

    ! Social withdrawal
    soc_with BY erq11* erq21 erq30;
    soc_with@1;

    ! Distraction
    distract BY erq9* erq19 erq28;
    distract@1;

    ! Rumination
    rumin BY erq8* erq18 erq27;
    rumin@1;

    ! Acceptance
    accept BY erq10* erq20 erq29;
    accept@1;

    ! Cognitive reappraisal
    reapp BY erq1* erq3 erq12;
    reapp@1;

    ! Expressive suppression
    suppress BY erq2* erq13 erq22;
    suppress@1;

    ! Social sharing
    sharing BY erq7* erq17 erq26;
    sharing@1;

    ! Correlations of interest: DBS negative beliefs with ERQ-30
    dbs_neg WITH beh_act prob_sol sit_avo soc_with distract
                 rumin accept reapp suppress sharing;

    ! Allow all ERQ-30 factors to correlate
    beh_act WITH prob_sol sit_avo soc_with distract
                 rumin accept reapp suppress sharing;
    prob_sol WITH sit_avo soc_with distract rumin
                  accept reapp suppress sharing;
    sit_avo WITH soc_with distract rumin accept
                 reapp suppress sharing;
    soc_with WITH distract rumin accept reapp suppress sharing;
    distract WITH rumin accept reapp suppress sharing;
    rumin WITH accept reapp suppress sharing;
    accept WITH reapp suppress sharing;
    reapp WITH suppress sharing;
    suppress WITH sharing;

  OUTPUT:
    STANDARDIZED CINTERVAL;



INPUT READING TERMINATED NORMALLY



