INPUT INSTRUCTIONS

  TITLE:  Reliability - German Version of the Dissociation Beliefs Scale (DBS)

  DATA:   FILE = cfa.txt;

  VARIABLE:
          NAMES = id dbs1-dbs16;
          USEVARIABLES = dbs1 dbs2 dbs3 dbs5 dbs7 dbs13 dbs15 dbs16;
          MISSING = *;

  ANALYSIS:
          ESTIMATOR = MLR;

  MODEL:
          ! measurement model
          dbs_pos BY dbs1*  (load1)
                     dbs2   (load2)
                     dbs3   (load3)
                     dbs5   (load4)
                     dbs7   (load5)
                     dbs13  (load6)
                     dbs15  (load7)
                     dbs16  (load8);
          dbs_pos@1;

          ! residual variances
          dbs1   (resv1);
          dbs2   (resv2);
          dbs3   (resv3);
          dbs5   (resv4);
          dbs7   (resv5);
          dbs13  (resv6);
          dbs15  (resv7);
          dbs16  (resv8);

  MODEL CONSTRAINT:
          NEW(omega);
          omega = (load1+load2+load3+load4+load5+load6+load7+load8)^2 /
                  ((load1+load2+load3+load4+load5+load6+load7+load8)^2 +
                   resv1+resv2+resv3+resv4+resv5+resv6+resv7+resv8);

  OUTPUT: CINTERVAL;



