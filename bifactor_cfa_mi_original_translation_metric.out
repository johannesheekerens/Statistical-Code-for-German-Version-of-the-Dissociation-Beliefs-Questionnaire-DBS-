Mplus VERSION 9
MUTHEN & MUTHEN
11/02/2026   2:32 PM

INPUT INSTRUCTIONS

  TITLE: Multi-group bifactor CFA for metric invariance
         across the German and French versions;

  DATA:
      FILE = mg_cfa.txt;

  VARIABLE:
      NAMES = id dbs1-dbs16 group;
      USEVARIABLES = dbs1-dbs16;
      GROUPING = group (1 = German 2 = French);

  ANALYSIS:
      ESTIMATOR = MLR;
      STARTS = 20;

  MODEL:
      dbs_g BY dbs1*  (g1)
               dbs2   (g2)
               dbs3   (g3)
               dbs4   (g4)
               dbs5   (g5)
               dbs6   (g6)
               dbs7   (g7)
               dbs8   (g8)
               dbs9   (g9)
               dbs10  (g10)
               dbs11  (g11)
               dbs12  (g12)
               dbs13  (g13)
               dbs14  (g14)
               dbs15  (g15)
               dbs16  (g16);

      dbs_pos BY dbs1*  (p1)
                 dbs2   (p2)
                 dbs3   (p3)
                 dbs5   (p5)
                 dbs7   (p7)
                 dbs13  (p13)
                 dbs15  (p15)
                 dbs16  (p16);

      dbs_neg BY dbs4*  (n4)
                 dbs6   (n6)
                 dbs8   (n8)
                 dbs9   (n9)
                 dbs10  (n10)
                 dbs11  (n11)
                 dbs12  (n12)
                 dbs14  (n14);

      [dbs_g@0 dbs_pos@0 dbs_neg@0];

      dbs_g@1;
      dbs_pos@1;
      dbs_neg@1;

      dbs_g WITH dbs_pos@0;
      dbs_g WITH dbs_neg@0;
      dbs_pos WITH dbs_neg@0;

      [dbs1-dbs16*];
      dbs1-dbs16*;

  MODEL French:
      dbs_g BY dbs1*  (g1)
               dbs2   (g2)
               dbs3   (g3)
               dbs4   (g4)
               dbs5   (g5)
               dbs6   (g6)
               dbs7   (g7)
               dbs8   (g8)
               dbs9   (g9)
               dbs10  (g10)
               dbs11  (g11)
               dbs12  (g12)
               dbs13  (g13)
               dbs14  (g14)
               dbs15  (g15)
               dbs16  (g16);

      dbs_pos BY dbs1*  (p1)
                 dbs2   (p2)
                 dbs3   (p3)
                 dbs5   (p5)
                 dbs7   (p7)
                 dbs13  (p13)
                 dbs15  (p15)
                 dbs16  (p16);

      dbs_neg BY dbs4*  (n4)
                 dbs6   (n6)
                 dbs8   (n8)
                 dbs9   (n9)
                 dbs10  (n10)
                 dbs11  (n11)
                 dbs12  (n12)
                 dbs14  (n14);

      [dbs_g@0 dbs_pos@0 dbs_neg@0];

      dbs_g*;
      dbs_pos*;
      dbs_neg*;

      dbs_g WITH dbs_pos@0;
      dbs_g WITH dbs_neg@0;
      dbs_pos WITH dbs_neg@0;

      [dbs1-dbs16*];
      dbs1-dbs16*;

  OUTPUT:
      STANDARDIZED;
      SVALUES;
      MODINDICES(5);
      TECH1;



INPUT READING TERMINATED NORMALLY



